# Vorlage für die lokalen Supabase-Zugangsdaten.
# Kopieren nach ".env.local" und die Werte eintragen (siehe docs/specs/supabase-einrichtung.md, Schritt 6 + 7a).
# Nur die öffentliche Project URL und den Publishable key (sb_publishable_…) – NIEMALS den Secret key (sb_secret_…).
VITE_SUPABASE_URL=https://DEINE-PROJEKT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
